{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "rimraf .next && rimraf out && rimraf dist-package",
    "fresh": "npm run clean && npm install && npm run build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "build:godaddy": "npm run clean && cp deployment/godaddy/next.config.production.mjs next.config.mjs && npm run build && npm run optimize:godaddy",
    "build:portable": "node deployment/portable/build-package.js",
    "deploy:godaddy": "node deployment/godaddy/scripts/deploy-godaddy.js",
    "deploy:test": "node deployment/godaddy/scripts/test-deployment.js",
    "deploy:rollback": "node deployment/godaddy/scripts/rollback.js",
    "optimize:godaddy": "npm run compress:images && npm run minify:css",
    "compress:images": "node deployment/godaddy/scripts/compress-images.js",
    "minify:css": "node deployment/godaddy/scripts/minify-css.js",
    "build:cpanel": "node deployment/cpanel/deploy-cpanel.js",
    "build:static": "node -e \"require('fs').copyFileSync('deployment/cpanel/next.config.static.mjs', 'next.config.mjs')\" && npm run build",
    "deploy:cpanel": "npm run build:cpanel"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
