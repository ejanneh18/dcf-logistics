# DCF Logistics - Static Deployment Environment Variables
# Copy this file to .env.local for static development

# Deployment Configuration
DEPLOYMENT_TYPE=static
NEXT_PUBLIC_DEPLOYMENT_TYPE=static
STATIC_EXPORT=true

# Application URLs (Update with your domain)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Company Information
NEXT_PUBLIC_COMPANY_NAME=DCF Logistics
NEXT_PUBLIC_COMPANY_ADDRESS=IC PLAZA Cooperative Junction Westfield Serekunda, The Gambia
NEXT_PUBLIC_PHONE=+220 395 1020
NEXT_PUBLIC_FAX=+220 395 1020

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=info@dcfagency.com
NEXT_PUBLIC_SALES_EMAIL=info@dcfagency.com
NEXT_PUBLIC_SUPPORT_EMAIL=info@dcfagency.com

# Business Hours
NEXT_PUBLIC_BUSINESS_HOURS=Monday - Friday: 8:00 AM - 6:00 PM
NEXT_PUBLIC_TIMEZONE=GMT

# Social Media Links
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/dcfagency
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/dcfagency
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/dcfagency
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/dcfagency

# Office Locations
NEXT_PUBLIC_MAIN_OFFICE=IC PLAZA Cooperative Junction Westfield Serekunda, The Gambia
NEXT_PUBLIC_BRANCH_OFFICES=Serrekunda, Brikama

# Services Information
NEXT_PUBLIC_SERVICES_AVAILABLE=Air Freight,Ground Transportation,Customs Clearance,Warehousing
NEXT_PUBLIC_COVERAGE_AREAS=West Africa,Europe,North America

# Demo Mode Configuration
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@dcfagency.com
NEXT_PUBLIC_DEMO_CUSTOMER_EMAIL=customer@demo.com

# External Service URLs (for static forms)
NEXT_PUBLIC_CONTACT_FORM_ACTION=mailto:info@dcfagency.com
NEXT_PUBLIC_QUOTE_FORM_ACTION=mailto:info@dcfagency.com

# Analytics (Client-side only)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX

# Map Configuration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_MAP_CENTER_LAT=13.4549
NEXT_PUBLIC_MAP_CENTER_LNG=-16.5790

# Feature Flags for Static Mode
NEXT_PUBLIC_ENABLE_CONTACT_FORM=true
NEXT_PUBLIC_ENABLE_QUOTE_FORM=true
NEXT_PUBLIC_ENABLE_TRACKING_DEMO=true
NEXT_PUBLIC_ENABLE_SERVICE_CALCULATOR=true

# Static Content Configuration
NEXT_PUBLIC_TESTIMONIALS_COUNT=6
NEXT_PUBLIC_SERVICES_COUNT=8
NEXT_PUBLIC_TEAM_MEMBERS_COUNT=4

# SEO Configuration
NEXT_PUBLIC_SITE_TITLE=DCF Logistics - Professional Logistics Services
NEXT_PUBLIC_SITE_DESCRIPTION=Leading logistics company in The Gambia providing air freight, ground transportation, customs clearance, and warehousing services.
NEXT_PUBLIC_SITE_KEYWORDS=logistics,freight,shipping,gambia,transportation,customs,warehousing

# Legal Information
NEXT_PUBLIC_COMPANY_REGISTRATION=RC-12345-GM
NEXT_PUBLIC_TAX_ID=TAX-67890-GM
NEXT_PUBLIC_LICENSE_NUMBER=LOG-2024-001

# Emergency Contact
NEXT_PUBLIC_EMERGENCY_PHONE=+220-999-0000
NEXT_PUBLIC_EMERGENCY_EMAIL=info@dcfagency.com

# Build Configuration
NEXT_PUBLIC_BUILD_TIME=${new Date().toISOString()}
NEXT_PUBLIC_VERSION=1.0.0
