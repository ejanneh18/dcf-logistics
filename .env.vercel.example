# DCF Logistics - Vercel Deployment Environment Variables
# Copy this file to .env.local for development or configure in Vercel Dashboard

# Deployment Configuration
DEPLOYMENT_TYPE=vercel
NEXT_PUBLIC_DEPLOYMENT_TYPE=vercel

# Application URLs
NEXTAUTH_URL=https://your-vercel-domain.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-vercel-domain.vercel.app
APP_URL=https://your-vercel-domain.vercel.app

# Authentication (NextAuth.js)
NEXTAUTH_SECRET=your-super-secure-32-character-secret-key-here

# Database Configuration (PostgreSQL recommended)
DATABASE_URL=postgresql://username:password@host:5432/dcf_logistics

# Email Service Configuration (SendGrid recommended)
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=DCF Logistics

# Alternative SMTP Configuration
SMTP_HOST=smtp.youremailprovider.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@yourdomain.com

# Contact Information
CONTACT_EMAIL=info@yourdomain.com
SALES_EMAIL=sales@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# Company Information
NEXT_PUBLIC_COMPANY_NAME=DCF Logistics
NEXT_PUBLIC_COMPANY_ADDRESS=IC PLAZA Cooperative Junction Westfield Serekunda, The Gambia
NEXT_PUBLIC_PHONE=+220 395 1020

# Payment Processing (Stripe)
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# File Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# AI Services (Optional)
OPENAI_API_KEY=sk-your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VERCEL_ANALYTICS_ID=your-vercel-analytics-id

# Feature Flags
EMAIL_QUEUE_ENABLED=true
RATE_LIMIT_ENABLED=true
WEBSOCKET_ENABLED=true
PUSH_NOTIFICATIONS_ENABLED=true

# Security
CORS_ORIGIN=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://your-vercel-domain.vercel.app

# Database Pool Configuration
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration (Optional for caching)
REDIS_URL=redis://username:password@host:port

# Monitoring (Optional)
SENTRY_DSN=https://your-sentry-dsn
SENTRY_ORG=your-org
SENTRY_PROJECT=dcf-logistics
